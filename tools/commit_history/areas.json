{
  "_comment": "Feature areas for the commit history page. Each changed file goes to the first area whose pattern matches its path (fnmatch: * also matches '/'). Order matters.",
  "areas": [
    {
      "id": "ci",
      "label": "CI·도구",
      "description": "GitHub Actions, 린트·포맷 설정, 개발 도구",
      "patterns": [".github/*", "scripts/lint.sh", "requirements-lint.txt", "pyproject.toml",
                   ".clang-format", ".cmake-format.yaml", ".editorconfig", "tools/*"]
    },
    {
      "id": "cup",
      "label": "컵 루틴",
      "description": "컵 접근·보정·놓기·잡기, 컵 핸드오버, 붓기",
      "patterns": ["*cup*", "*pour*", "src/motions/place/*", "include/demo_1f/motions/place/*",
                   "config/approach.yaml", "launch/approach_cup*", "*approach*"]
    },
    {
      "id": "handover",
      "label": "셀 핸드오버",
      "description": "오른손에서 왼손으로 셀을 넘기는 양팔 동작",
      "patterns": ["*handover*", "src/motions/handover/*", "include/demo_1f/motions/handover/*",
                   "*retarget_handover*"]
    },
    {
      "id": "pick",
      "label": "셀 픽",
      "description": "다이나믹셀 파지 계획·해석 IK·픽 실행 (ffw_pick, ffw_grasp)",
      "patterns": ["modules/dynamixel_pick/ffw_pick/*", "modules/dynamixel_pick/ffw_grasp/*",
                   "src/motions/pick/*", "include/demo_1f/motions/pick/*", "config/pick.yaml",
                   "*dynamixel_pick.launch*", "scripts/*pick*", "*gripper*"]
    },
    {
      "id": "perception",
      "label": "인식",
      "description": "카메라 인식, 손목 깊이 측정, 바구니·책상 위치",
      "patterns": ["modules/dynamixel_pick/ffw_vision/*", "src/perception/*",
                   "include/demo_1f/perception/*", "*perception*", "scripts/wrist_*",
                   "*basket*", "*table*", "*depth*", "*camera*", "*wrist*",
                   "modules/dynamixel_pick/ffw_vision_msgs/*", "models/*", "*onnx*"]
    },
    {
      "id": "initial",
      "label": "초기 자세",
      "description": "초기 자세 이동과 준비 상태 확인",
      "patterns": ["*initial*", "*right_ready*"]
    },
    {
      "id": "motion",
      "label": "모션 실행",
      "description": "MoveIt 계획·스무딩·궤적 실행, 로봇 상태, SG2 모델",
      "patterns": ["src/runtime/*", "include/demo_1f/runtime/*", "include/demo_1f/core/*",
                   "src/moveit_plugins/*", "include/demo_1f/moveit_plugins/*", "*sg2*",
                   "planning_request_adapters.xml", "constraint_samplers.xml", "*ptp*",
                   "*trajectory*", "src/motions/*", "include/demo_1f/motions/*", "*dual_arm*",
                   "*arm_coordination*", "*round_trip*", "*start_state*", "*tcp*"]
    },
    {
      "id": "task",
      "label": "작업 흐름",
      "description": "TaskManager 순서·재시도·재개, 노드, 액션 러너",
      "patterns": ["src/tasks/*", "include/demo_1f/tasks/*", "src/nodes/*", "config/demo.yaml",
                   "scripts/action_runner.py", "scripts/run_actions.sh", "launch/full_demo*",
                   "action/*", "msg/*", "test/test_demo_task*"]
    },
    {
      "id": "cumotion_description",
      "label": "로봇 모델",
      "description": "cuMotion 로봇 URDF·메시",
      "patterns": ["*cyclo_cumotion_description/*"]
    },
    {
      "id": "cumotion_moveit",
      "label": "cuMotion MoveIt",
      "description": "cuMotion MoveIt 설정과 플래너 연동",
      "patterns": ["*cyclo_cumotion_moveit_config/*", "*cyclo_cumotion_bringup/*",
                   "cyclo_cumotion/launch/*"]
    },
    {
      "id": "cumotion_nvblox",
      "label": "nvblox·장애물",
      "description": "nvblox 지도, 로봇 분할, 물체 부착",
      "patterns": ["*cyclo_cumotion_nvblox/*", "*cyclo_cumotion_robot_segmenter/*",
                   "*cyclo_cumotion_object_attachment/*"]
    },
    {
      "id": "build",
      "label": "빌드·환경",
      "description": "Docker, CMake, 패키지 정의, 빌드 스크립트",
      "patterns": ["docker/*", "CMakeLists.txt", "*/CMakeLists.txt", "package.xml", "*/package.xml",
                   "setup.py", "*/setup.py", "*/setup.cfg", "scripts/*.sh", ".gitignore",
                   ".dockerignore", "*COLCON_IGNORE", "*AMENT_IGNORE", "*.repos",
                   "test/run_isolated.sh", "test/launch_smoke*"]
    },
    {
      "id": "docs",
      "label": "문서",
      "description": "README와 설계 문서",
      "patterns": ["*.md", "*.rst", "docs/*", "LICENSE", "*/LICENSE", "NOTICE"]
    }
  ],
  "fallback": {
    "id": "other",
    "label": "기타",
    "description": "다른 영역에 속하지 않는 파일"
  }
}
